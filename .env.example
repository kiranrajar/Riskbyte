# ==============================================================================
# RiskByte SOC Agent — Enterprise Configuration Reference (.env.example)
# Commercial On-Premises Air-Gapped SOC Automation Platform
# ==============================================================================

# ---- Platform & Environment ----
RISKBYTE_ENV=production                  # production | development | test
RISKBYTE_BIND=0.0.0.0
RISKBYTE_PORT=8080
RISKBYTE_SYSLOG_PORT=5514
RISKBYTE_DATA_DIR=/data
RISKBYTE_AIR_GAPPED=true                 # true = strictly blocks external network calls
RISKBYTE_EGRESS_DENY=true                # true = enforces outbound firewall egress drop

# ---- Database & Persistence ----
# PostgreSQL 16 (relational platform data, cases, alerts, users, sessions)
RISKBYTE_DATABASE_URL=postgresql://riskbyte:ChangeMePostgresSecret2026!@postgres:5432/riskbyte
# Redis 7.2 (asynchronous task broker, session lock, rate limit counters)
RISKBYTE_REDIS_URL=redis://:ChangeMeRedisSecret2026!@redis:6379/0
# OpenSearch 2.14 / Wazuh Indexer (normalized OCSF event search & indexing)
RISKBYTE_OPENSEARCH_URL=http://opensearch:9200

# ---- Air-Gapped Self-Hosted LLM Runtime ----
RISKBYTE_OLLAMA_URL=http://ollama:11434  # Local container inference endpoint
RISKBYTE_LLM_MODEL=llama3.1:8b           # Recommended: llama3.1:8b, qwen2.5:14b, mistral:7b
RISKBYTE_LLM_TIMEOUT=60

# ---- Cryptographic Instance Keys & Envelope Encryption ----
RISKBYTE_KEY_DIR=/data/keys              # RSA-4096 instance private/public keypair
RISKBYTE_AUDIT_BATCH_SIZE=50             # Batch size for RSASSA-PSS block signing

# ---- Offline Subscription Licensing ----
RISKBYTE_LICENSE_PATH=/data/license.rbl  # Signed customer license file
RISKBYTE_LICENSE_PUBKEY=/data/vendor_public.pem # Vendor RSA-4096 signature verification key

# ---- Root Break-Glass Administrator (Initial Seeding) ----
RISKBYTE_ADMIN_EMAIL=admin@riskbyte.internal
RISKBYTE_ADMIN_PASSWORD=EnterpriseAdmin2026!# # Min 16 chars, Argon2id hashed

# ---- Modular Connectors Configuration ----
# Wazuh Manager API (port 55000) & Indexer (port 9200)
RISKBYTE_WAZUH_URL=https://wazuh.internal:55000
RISKBYTE_WAZUH_USER=wazuh-api
RISKBYTE_WAZUH_PASSWORD=WazuhSecretPassword2026!
RISKBYTE_WAZUH_VERIFY_SSL=true

# Suricata IDS/IPS EVE JSON
RISKBYTE_SURICATA_EVE_PATH=/var/log/suricata/eve.json
RISKBYTE_SURICATA_SOCKET_PATH=/var/run/suricata/suricata-command.socket

# Zeek Network Security Monitor
RISKBYTE_ZEEK_LOG_DIR=/opt/zeek/logs/current

# TheHive 5 & Cortex
RISKBYTE_THEHIVE_URL=https://thehive.internal:9000
RISKBYTE_THEHIVE_API_KEY=TheHiveApiKeySecret2026!
RISKBYTE_CORTEX_URL=https://cortex.internal:9001
RISKBYTE_CORTEX_API_KEY=CortexApiKeySecret2026!

# Splunk Enterprise / Enterprise Security
RISKBYTE_SPLUNK_URL=https://splunk.internal:8089
RISKBYTE_SPLUNK_TOKEN=SplunkBearerToken2026!

# MISP Local Threat Intelligence Feed
RISKBYTE_MISP_URL=https://misp.internal
RISKBYTE_MISP_KEY=MispAuthKeySecret2026!
